{
  "version": 1,
  "default": [
    "unit",
    "ui"
  ],
  "defaults": {
    "EDITING_TOOLS_MOTION_DIR": "{root}/../motion-tools.nvim",
    "EDITING_TOOLS_PAIRS_DIR": "{root}/../pairs.nvim"
  },
  "cases": [
    {
      "name": "docs",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/docs_checks.py",
        "--nvim",
        "{nvim}"
      ],
      "files": [
        "tests/docs_checks.py"
      ],
      "timeout": 60
    },
    {
      "name": "runner-contracts",
      "suite": "unit",
      "command": [
        "{python}",
        "tests/runner_checks.py"
      ],
      "files": [
        "tests/runner_checks.py"
      ],
      "timeout": 120
    },
    {
      "name": "lazy_loading",
      "suite": "unit",
      "command": [
        "{nvim}",
        "--headless",
        "-u",
        "NONE",
        "-i",
        "NONE",
        "-n",
        "+set rtp^=.",
        "+lua local ok, err = xpcall(function() dofile('tests/lazy_loading.lua') end, debug.traceback); if not ok then print(err); vim.cmd('cquit 1') end",
        "+qa!"
      ],
      "files": [
        "tests/lazy_loading.lua"
      ],
      "timeout": 90
    },
    {
      "name": "setup_contract",
